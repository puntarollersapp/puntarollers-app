diff --git a/public/sw.js b/public/sw.js
new file mode 100644
index 0000000..90b6e23
--- /dev/null
+++ b/public/sw.js
@@ -0,0 +1,12 @@
+// Retire the old offline application and move existing installed clients to PR.
+self.addEventListener('install',()=>self.skipWaiting())
+self.addEventListener('activate',event=>event.waitUntil((async()=>{
+  await self.clients.claim()
+  const clients=await self.clients.matchAll({type:'window'})
+  for(const client of clients){
+    const path=new URL(client.url).pathname
+    const destination=path.startsWith('/admin')?'https://www.puntarollers.com/admin/rollermap':`https://www.puntarollers.com/rollermap${path.startsWith('/lugar/')?path:'/'}`
+    await client.navigate(destination).catch(()=>{})
+  }
+  await self.registration.unregister()
+})()))
